import SwiftUI
import SwiftData

struct ShiftTemplateListView: View {
    @Environment(\.modelContext) private var modelContext
    @Query(sort: \ShiftTemplate.sortOrder) private var templates: [ShiftTemplate]
    @State private var showingAdd = false
    
    var body: some View {
        List {
            ForEach(templates) { template in
                NavigationLink {
                    ShiftTemplateEditView(template: template)
                } label: {
                    HStack(spacing: 12) {
                        Circle()
                            .fill(template.color)
                            .frame(width: 14, height: 14)
                        
                        VStack(alignment: .leading, spacing: 2) {
                            Text(template.name)
                                .font(.body.weight(.medium))
                            Text(template.timeText)
                                .font(.caption)
                                .foregroundStyle(.secondary)
                        }
                        
                        Spacer()
                        
                        Text("$\(template.hourlyRate as NSDecimalNumber)")
                            .font(.subheadline)
                            .foregroundStyle(.secondary)
                    }
                    .padding(.vertical, 2)
                }
            }
            .onDelete(perform: delete)
        }
        .navigationTitle("班次管理")
        .toolbar {
            Button {
                showingAdd = true
            } label: {
                Image(systemName: "plus")
            }
        }
        .sheet(isPresented: $showingAdd) {
            ShiftTemplateEditView(template: nil)
        }
    }
    
    private func delete(at offsets: IndexSet) {
        for index in offsets {
            modelContext.delete(templates[index])
        }
    }
}

struct ShiftTemplateEditView: View {
    @Environment(\.modelContext) private var modelContext
    @Environment(\.dismiss) private var dismiss
    
    let template: ShiftTemplate?
    
    @State private var name = ""
    @State private var colorHex = "#4A90E2"
    @State private var startHour = 9
    @State private var startMinute = 0
    @State private var endHour = 18
    @State private var endMinute = 0
    @State private var hourlyRate: Decimal = 200
    
    private let colors = ["#4A90E2", "#7ED321", "#F5A623", "#D0021B", "#BD10E0", "#50E3C2", "#B8E986", "#9013FE"]
    
    var body: some View {
        NavigationStack {
            Form {
                Section("基本資料") {
                    TextField("班次名稱", text: $name)
                    
                    // 簡單顏色選擇
                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: 12) {
                            ForEach(colors, id: \.self) { hex in
                                Circle()
                                    .fill(Color(hex: hex) ?? .gray)
                                    .frame(width: 32, height: 32)
                                    .overlay {
                                        if colorHex == hex {
                                            Image(systemName: "checkmark")
                                                .foregroundStyle(.white)
                                                .font(.caption.bold())
                                        }
                                    }
                                    .onTapGesture { colorHex = hex }
                            }
                        }
                        .padding(.vertical, 4)
                    }
                }
                
                Section("時間") {
                    Stepper("開始 \(String(format: "%02d:%02d", startHour, startMinute))", value: $startHour, in: 0...23)
                    Stepper("結束 \(String(format: "%02d:%02d", endHour, endMinute))", value: $endHour, in: 0...23)
                }
                
                Section("時薪") {
                    TextField("時薪", value: $hourlyRate, format: .number)
                        .keyboardType(.decimalPad)
                }
            }
            .navigationTitle(template == nil ? "新增班次" : "編輯班次")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("取消") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("儲存") { save() }
                        .disabled(name.trimmingCharacters(in: .whitespaces).isEmpty)
                }
            }
            .onAppear {
                if let t = template {
                    name = t.name
                    colorHex = t.colorHex
                    startHour = t.startHour
                    startMinute = t.startMinute
                    endHour = t.endHour
                    endMinute = t.endMinute
                    hourlyRate = t.hourlyRate
                }
            }
        }
    }
    
    private func save() {
        if let t = template {
            t.name = name
            t.colorHex = colorHex
            t.startHour = startHour
            t.startMinute = startMinute
            t.endHour = endHour
            t.endMinute = endMinute
            t.hourlyRate = hourlyRate
        } else {
            let new = ShiftTemplate(
                name: name,
                colorHex: colorHex,
                startHour: startHour,
                startMinute: startMinute,
                endHour: endHour,
                endMinute: endMinute,
                hourlyRate: hourlyRate,
                sortOrder: 99
            )
            modelContext.insert(new)
        }
        try? modelContext.save()
        dismiss()
    }
}

import Foundation
import WidgetKit

struct WidgetShiftInfo: Codable, Identifiable {
    var id: UUID = UUID()
    let date: Date
    let name: String
    let colorHex: String
    let startTime: String
    let endTime: String
    
    enum CodingKeys: String, CodingKey {
        case date, name, colorHex, startTime, endTime
    }
}

class WidgetDataManager {
    static let shared = WidgetDataManager()
    
    // ⚠️ 請改成你自己的 App Group ID
    private let suiteName = "group.com.yourname.shiftplan"
    private let key = "widgetData"
    
    func update(todayShifts: [WidgetShiftInfo]) {
        if let data = try? JSONEncoder().encode(todayShifts) {
            UserDefaults(suiteName: suiteName)?.set(data, forKey: key)
        }
        WidgetCenter.shared.reloadAllTimelines()
    }
    
    func load() -> [WidgetShiftInfo] {
        guard let data = UserDefaults(suiteName: suiteName)?.data(forKey: key),
              let decoded = try? JSONDecoder().decode([WidgetShiftInfo].self, from: data) else {
            return []
        }
        return decoded
    }
}

import WidgetKit
import SwiftUI

struct Provider: TimelineProvider {
    func placeholder(in context: Context) -> SimpleEntry {
        SimpleEntry(date: Date(), shifts: [])
    }
    
    func getSnapshot(in context: Context, completion: @escaping (SimpleEntry) -> ()) {
        let entry = SimpleEntry(date: Date(), shifts: loadShifts())
        completion(entry)
    }
    
    func getTimeline(in context: Context, completion: @escaping (Timeline<SimpleEntry>) -> ()) {
        let entry = SimpleEntry(date: Date(), shifts: loadShifts())
        let nextUpdate = Calendar.current.date(byAdding: .minute, value: 30, to: Date())!
        let timeline = Timeline(entries: [entry], policy: .after(nextUpdate))
        completion(timeline)
    }
    
    private func loadShifts() -> [WidgetShiftInfo] {
        // ⚠️ 請改成你自己的 App Group ID
        let suiteName = "group.com.yourname.shiftplan"
        guard let data = UserDefaults(suiteName: suiteName)?.data(forKey: "widgetData"),
              let decoded = try? JSONDecoder().decode([WidgetShiftInfo].self, from: data) else {
            return []
        }
        return decoded
    }
}

struct SimpleEntry: TimelineEntry {
    let date: Date
    let shifts: [WidgetShiftInfo]
}

struct ShiftPlanWidgetEntryView: View {
    var entry: Provider.Entry
    @Environment(\.widgetFamily) var family
    
    var body: some View {
        switch family {
        case .systemSmall:
            SmallView(shifts: entry.shifts)
        case .systemMedium:
            MediumView(shifts: entry.shifts)
        default:
            SmallView(shifts: entry.shifts)
        }
    }
}

struct SmallView: View {
    let shifts: [WidgetShiftInfo]
    
    var body: some View {
        VStack(alignment: .leading, spacing: 6) {
            Text("今日班表")
                .font(.caption.bold())
                .foregroundStyle(.secondary)
            
            if shifts.isEmpty {
                Text("今日無班")
                    .font(.subheadline)
                    .foregroundStyle(.secondary)
            } else {
                ForEach(shifts.prefix(2)) { shift in
                    HStack(spacing: 6) {
                        Circle()
                            .fill(Color(hex: shift.colorHex) ?? .blue)
                            .frame(width: 8, height: 8)
                        VStack(alignment: .leading, spacing: 1) {
                            Text(shift.name)
                                .font(.subheadline.bold())
                                .lineLimit(1)
                            Text("\(shift.startTime)-\(shift.endTime)")
                                .font(.caption2)
                                .foregroundStyle(.secondary)
                        }
                    }
                }
            }
            Spacer(minLength: 0)
        }
        .padding()
    }
}

struct MediumView: View {
    let shifts: [WidgetShiftInfo]
    
    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            Text("今日班表")
                .font(.headline)
            
            if shifts.isEmpty {
                Text("今日無班")
                    .foregroundStyle(.secondary)
            } else {
                ForEach(shifts) { shift in
                    HStack {
                        Circle()
                            .fill(Color(hex: shift.colorHex) ?? .blue)
                            .frame(width: 10, height: 10)
                        Text(shift.name)
                            .font(.subheadline.bold())
                        Spacer()
                        Text("\(shift.startTime) - \(shift.endTime)")
                            .font(.caption)
                            .foregroundStyle(.secondary)
                    }
                }
            }
            Spacer()
        }
        .padding()
    }
}

struct ShiftPlanWidget: Widget {
    let kind: String = "ShiftPlanWidget"
    
    var body: some WidgetConfiguration {
        StaticConfiguration(kind: kind, provider: Provider()) { entry in
            ShiftPlanWidgetEntryView(entry: entry)
                .containerBackground(.fill.tertiary, for: .widget)
        }
        .configurationDisplayName("今日班表")
        .description("快速查看今天的班次")
        .supportedFamilies([.systemSmall, .systemMedium])
    }
}

// Color 擴充（Widget 也需要）
extension Color {
    init?(hex: String) {
        var hexSanitized = hex.trimmingCharacters(in: .whitespacesAndNewlines)
        hexSanitized = hexSanitized.replacingOccurrences(of: "#", with: "")
        var rgb: UInt64 = 0
        Scanner(string: hexSanitized).scanHexInt64(&rgb)
        let r = Double((rgb & 0xFF0000) >> 16) / 255.0
        let g = Double((rgb & 0x00FF00) >> 8) / 255.0
        let b = Double(rgb & 0x0000FF) / 255.0
        self.init(red: r, green: g, blue: b)
    }
}



