import Foundation
import SwiftData
import SwiftUI

@Model
final class ShiftTemplate {
    var id: UUID
    var name: String
    var colorHex: String
    var startHour: Int
    var startMinute: Int
    var endHour: Int
    var endMinute: Int
    var hourlyRate: Decimal
    var sortOrder: Int
    
    init(name: String, colorHex: String, startHour: Int, startMinute: Int,
         endHour: Int, endMinute: Int, hourlyRate: Decimal, sortOrder: Int = 0) {
        self.id = UUID()
        self.name = name
        self.colorHex = colorHex
        self.startHour = startHour
        self.startMinute = startMinute
        self.endHour = endHour
        self.endMinute = endMinute
        self.hourlyRate = hourlyRate
        self.sortOrder = sortOrder
    }
    
    var color: Color {
        Color(hex: colorHex) ?? .blue
    }
    
    var durationHours: Double {
        let start = Double(startHour) + Double(startMinute) / 60.0
        var end = Double(endHour) + Double(endMinute) / 60.0
        if end <= start { end += 24 }
        return end - start
    }
    
    var timeText: String {
        String(format: "%02d:%02d-%02d:%02d", startHour, startMinute, endHour, endMinute)
    }
}

@Model
final class ShiftRecord {
    var id: UUID
    var date: Date
    var template: ShiftTemplate?
    
    init(date: Date, template: ShiftTemplate?) {
        self.id = UUID()
        self.date = date
        self.template = template
    }
}

// Color Hex 擴充
extension Color {
    init?(hex: String) {
        var hexSanitized = hex.trimmingCharacters(in: .whitespacesAndNewlines)
        hexSanitized = hexSanitized.replacingOccurrences(of: "#", with: "")
        
        var rgb: UInt64 = 0
        Scanner(string: hexSanitized).scanHexInt64(&rgb)
        
        let r = Double((rgb & 0xFF0000) >> 16) / 255.0
        let g = Double((rgb & 0x00FF00) >> 8) / 255.0
        let b = Double(rgb & 0x0000FF) / 255.0
        
        self.init(red: r, green: g, blue: b)
    }
}

import SwiftUI
import SwiftData

@main
struct ShiftPlanApp: App {
    var body: some Scene {
        WindowGroup {
            ContentView()
        }
        .modelContainer(for: [ShiftTemplate.self, ShiftRecord.self])
    }
}

import SwiftUI
import SwiftData
import WidgetKit

struct ContentView: View {
    @Environment(\.modelContext) private var modelContext
    @Query(sort: \ShiftTemplate.sortOrder) private var templates: [ShiftTemplate]
    @Query private var records: [ShiftRecord]
    
    @State private var currentMonth = Date()
    @State private var selectedTemplate: ShiftTemplate?
    
    private let calendar = Calendar.current
    
    var body: some View {
        NavigationStack {
            VStack(spacing: 0) {
                // 月份切換
                HStack {
                    Button {
                        changeMonth(by: -1)
                    } label: {
                        Image(systemName: "chevron.left")
                            .font(.title3)
                    }
                    
                    Spacer()
                    
                    Text(currentMonth, format: .dateTime.year().month())
                        .font(.title2.bold())
                    
                    Spacer()
                    
                    Button {
                        changeMonth(by: 1)
                    } label: {
                        Image(systemName: "chevron.right")
                            .font(.title3)
                    }
                }
                .padding()
                
                // 快速班次按鈕
                ScrollView(.horizontal, showsIndicators: false) {
                    HStack(spacing: 10) {
                        ForEach(templates) { template in
                            Button {
                                selectedTemplate = (selectedTemplate?.id == template.id) ? nil : template
                            } label: {
                                Text(template.name)
                                    .font(.subheadline.bold())
                                    .padding(.horizontal, 14)
                                    .padding(.vertical, 8)
                                    .background(selectedTemplate?.id == template.id ? template.color : template.color.opacity(0.25))
                                    .foregroundStyle(selectedTemplate?.id == template.id ? .white : .primary)
                                    .clipShape(Capsule())
                            }
                        }
                    }
                    .padding(.horizontal)
                }
                .padding(.bottom, 12)
                
                // 月曆
                MonthGridView(
                    month: currentMonth,
                    records: records,
                    onTapDate: { date in
                        guard let template = selectedTemplate else { return }
                        addOrUpdateShift(on: date, template: template)
                    }
                )
                
                Spacer()
                
                // 底部薪資摘要
                SalarySummaryView(records: records)
            }
            .navigationTitle("班表")
            .toolbar {
                ToolbarItem(placement: .topBarLeading) {
                    NavigationLink {
                        ShiftTemplateListView()
                    } label: {
                        Image(systemName: "list.bullet")
                    }
                }
                
                ToolbarItem(placement: .topBarTrailing) {
                    Button("今天") {
                        currentMonth = Date()
                    }
                }
            }
            .onAppear {
                createDefaultTemplatesIfNeeded()
                updateWidget()
            }
            .onChange(of: records.count) {
                updateWidget()
            }
        }
    }
    
    private func changeMonth(by value: Int) {
        if let newDate = calendar.date(byAdding: .month, value: value, to: currentMonth) {
            currentMonth = newDate
        }
    }
    
    private func addOrUpdateShift(on date: Date, template: ShiftTemplate) {
        let day = calendar.startOfDay(for: date)
        
        if let existing = records.first(where: { calendar.isDate($0.date, inSameDayAs: day) }) {
            // 再點一次相同班次 → 刪除
            if existing.template?.id == template.id {
                modelContext.delete(existing)
            } else {
                existing.template = template
            }
        } else {
            let newRecord = ShiftRecord(date: day, template: template)
            modelContext.insert(newRecord)
        }
        
        try? modelContext.save()
        updateWidget()
    }
    
    private func createDefaultTemplatesIfNeeded() {
        guard templates.isEmpty else { return }
        
        let defaults: [(String, String, Int, Int, Int, Int, Decimal, Int)] = [
            ("早班", "#4A90E2", 8, 0, 16, 0, 200, 0),
            ("中班", "#7ED321", 16, 0, 24, 0, 200, 1),
            ("晚班", "#F5A623", 0, 0, 8, 0, 220, 2),
            ("休假", "#BD10E0", 0, 0, 0, 0, 0, 3)
        ]
        
        for item in defaults {
            let t = ShiftTemplate(
                name: item.0,
                colorHex: item.1,
                startHour: item.2,
                startMinute: item.3,
                endHour: item.4,
                endMinute: item.5,
                hourlyRate: item.6,
                sortOrder: item.7
            )
            modelContext.insert(t)
        }
        try? modelContext.save()
    }
    
    private func updateWidget() {
        let calendar = Calendar.current
        let today = calendar.startOfDay(for: Date())
        
        let todayRecords = records.filter { calendar.isDate($0.date, inSameDayAs: today) }
        
        let todayShifts: [WidgetShiftInfo] = todayRecords.compactMap { record in
            guard let t = record.template else { return nil }
            return WidgetShiftInfo(
                date: record.date,
                name: t.name,
                colorHex: t.colorHex,
                startTime: String(format: "%02d:%02d", t.startHour, t.startMinute),
                endTime: String(format: "%02d:%02d", t.endHour, t.endMinute)
            )
        }
        
        WidgetDataManager.shared.update(todayShifts: todayShifts)
    }
}

// 月曆格子
struct MonthGridView: View {
    let month: Date
    let records: [ShiftRecord]
    var onTapDate: (Date) -> Void
    
    private let calendar = Calendar.current
    private let columns = Array(repeating: GridItem(.flexible()), count: 7)
    
    var body: some View {
        let days = generateDays()
        
        LazyVGrid(columns: columns, spacing: 6) {
            ForEach(["日","一","二","三","四","五","六"], id: \.self) { weekday in
                Text(weekday)
                    .font(.caption)
                    .foregroundStyle(.secondary)
                    .frame(maxWidth: .infinity)
            }
            
            ForEach(Array(days.enumerated()), id: \.offset) { _, date in
                if let date {
                    let record = records.first { calendar.isDate($0.date, inSameDayAs: date) }
                    
                    VStack(spacing: 2) {
                        Text("\(calendar.component(.day, from: date))")
                            .font(.subheadline.weight(.medium))
                        
                        if let template = record?.template {
                            Text(template.name)
                                .font(.system(size: 10))
                                .padding(.horizontal, 4)
                                .padding(.vertical, 2)
                                .background(template.color.opacity(0.85))
                                .foregroundStyle(.white)
                                .clipShape(RoundedRectangle(cornerRadius: 4))
                        } else {
                            Spacer().frame(height: 18)
                        }
                    }
                    .frame(maxWidth: .infinity, minHeight: 52)
                    .contentShape(Rectangle())
                    .onTapGesture {
                        onTapDate(date)
                    }
                } else {
                    Color.clear.frame(height: 52)
                }
            }
        }
        .padding(.horizontal, 12)
    }
    
    private func generateDays() -> [Date?] {
        guard let range = calendar.range(of: .day, in: .month, for: month),
              let firstDay = calendar.date(from: calendar.dateComponents([.year, .month], from: month)) else {
            return []
        }
        
        let firstWeekday = calendar.component(.weekday, from: firstDay) - 1
        var days: [Date?] = Array(repeating: nil, count: firstWeekday)
        
        for day in range {
            if let date = calendar.date(byAdding: .day, value: day - 1, to: firstDay) {
                days.append(date)
            }
        }
        return days
    }
}

// 底部薪資摘要
struct SalarySummaryView: View {
    let records: [ShiftRecord]
    
    private var monthlyEarnings: Decimal {
        let calendar = Calendar.current
        let now = Date()
        
        return records
            .filter { calendar.isDate($0.date, equalTo: now, toGranularity: .month) }
            .reduce(Decimal(0)) { total, record in
                guard let t = record.template else { return total }
                return total + (Decimal(t.durationHours) * t.hourlyRate)
            }
    }
    
    var body: some View {
        HStack {
            VStack(alignment: .leading, spacing: 2) {
                Text("本月已賺")
                    .font(.caption)
                    .foregroundStyle(.secondary)
                Text("NT$ \(monthlyEarnings as NSDecimalNumber)")
                    .font(.title3.bold())
            }
            Spacer()
        }
        .padding()
        .background(.ultraThinMaterial)
    }
}

