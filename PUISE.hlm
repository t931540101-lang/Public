    private func changeMonth(by value: Int) {
        if let newDate = calendar.date(byAdding: .month, value: value, to: currentMonth) {
            currentMonth = newDate
        }
    }
    
    private func addOrUpdateShift(on date: Date, template: ShiftTemplate) {
        let day = calendar.startOfDay(for: date)
        
        if let existing = records.first(where: { calendar.isDate($0.date, inSameDayAs: day) }) {
            // 再點一次相同班次 → 刪除
            if existing.template?.id == template.id {
                modelContext.delete(existing)
            } else {
                existing.template = template
            }
        } else {
            let newRecord = ShiftRecord(date: day, template: template)
            modelContext.insert(newRecord)
        }
        
        try? modelContext.save()
        updateWidget()
    }
    
    private func createDefaultTemplatesIfNeeded() {
        guard templates.isEmpty else { return }
        
        let defaults: [(String, String, Int, Int, Int, Int, Decimal, Int)] = [
            ("早班", "#4A90E2", 8, 0, 16, 0, 200, 0),
            ("中班", "#7ED321", 16, 0, 24, 0, 200, 1),
            ("晚班", "#F5A623", 0, 0, 8, 0, 220, 2),
            ("休假", "#BD10E0", 0, 0, 0, 0, 0, 3)
        ]
        
        for item in defaults {
            let t = ShiftTemplate(
                name: item.0,
                colorHex: item.1,
                startHour: item.2,
                startMinute: item.3,
                endHour: item.4,
                endMinute: item.5,
                hourlyRate: item.6,
                sortOrder: item.7
            )
            modelContext.insert(t)
        }
        try? modelContext.save()
    }
    
    private func updateWidget() {
        let calendar = Calendar.current
        let today = calendar.startOfDay(for: Date())
        
        let todayRecords = records.filter { calendar.isDate($0.date, inSameDayAs: today) }
        
        let todayShifts: [WidgetShiftInfo] = todayRecords.compactMap { record in
            guard let t = record.template else { return nil }
            return WidgetShiftInfo(
                date: record.date,
                name: t.name,
                colorHex: t.colorHex,
                startTime: String(format: "%02d:%02d", t.startHour, t.startMinute),
                endTime: String(format: "%02d:%02d", t.endHour, t.endMinute)
            )
        }
        
        WidgetDataManager.shared.update(todayShifts: todayShifts)
    }
}

